rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function parent(family) { return signedIn() && request.auth.uid == family && request.auth.token.firebase.sign_in_provider != 'anonymous'; }
    function child(family) { return signedIn() && exists(/databases/$(database)/documents/families/$(family)/members/$(request.auth.uid)); }
    match /families/{family} {
      allow get: if parent(family) || child(family);
      allow list: if false;
      allow create, update: if parent(family);
      allow delete: if false;
      match /care/{careId} {
        function roundSeconds(session) { return session.matches('catch:.*') ? 20 : 30; }
        function today() { return int((request.time.toMillis() + 32400000) / 86400000); }
        function valid() {
          let d=request.resource.data;
          return d.keys().hasAll(['day','used','balance','session','startedAt','claimed','score','meals','lastFood','feedId'])
            && d.keys().hasOnly(['day','used','balance','session','startedAt','claimed','score','meals','lastFood','feedId'])
            && d.day is int && d.used is int && d.used >= 1 && d.used <= 5
            && d.balance is int && d.balance >= 0
            && d.session is string && d.session.size() > 0 && d.session.size() <= 64
            && d.startedAt is timestamp && d.claimed is bool
            && d.score is int && d.score >= (d.session.matches('catch:.*') ? -5 : 0) && d.score <= 30
            && d.meals.keys().hasAll(['berry','fish','soup']) && d.meals.keys().hasOnly(['berry','fish','soup'])
            && d.meals.berry is int && d.meals.berry >= 0
            && d.meals.fish is int && d.meals.fish >= 0
            && d.meals.soup is int && d.meals.soup >= 0
            && d.lastFood in ['', 'berry','fish','soup']
            && d.feedId is string && d.feedId.size() <= 64;
        }
        function start() {
          let d=request.resource.data;let old=resource.data;
          return d.diff(old).affectedKeys().hasOnly(['day','used','session','startedAt','claimed','score'])
            && d.day == today() && d.startedAt == request.time && !d.claimed && d.score == 0
            && d.session != old.session
            && (old.claimed || request.time >= old.startedAt + duration.value(roundSeconds(old.session),'s'))
            && d.used == (old.day == today() ? old.used + 1 : 1);
        }
        function finish() {
          let d=request.resource.data;let old=resource.data;
          return d.diff(old).affectedKeys().hasOnly(['claimed','score','balance'])
            && !old.claimed && d.claimed
            && request.time >= old.startedAt + duration.value(roundSeconds(old.session),'s')
            && d.balance == old.balance + 5 + d.score;
        }
        function feed() {
          let d=request.resource.data;let old=resource.data;
          let cost={'berry':10,'fish':15,'soup':20};
          return d.diff(old).affectedKeys().hasOnly(['balance','meals','lastFood','feedId'])
            && d.lastFood in cost && d.feedId.size() > 0 && d.feedId != old.feedId
            && d.balance == old.balance - cost[d.lastFood]
            && d.meals.diff(old.meals).affectedKeys().hasOnly([d.lastFood])
            && d.meals[d.lastFood] == old.meals[d.lastFood]+1;
        }
        allow get: if careId == 'state' && (parent(family) || child(family));
        allow create: if careId == 'state' && child(family) && valid()
          && request.resource.data.day == today() && request.resource.data.used == 1
          && request.resource.data.startedAt == request.time && !request.resource.data.claimed
          && request.resource.data.score == 0 && request.resource.data.balance == 0
          && request.resource.data.meals == {'berry':0,'fish':0,'soup':0}
          && request.resource.data.lastFood == '' && request.resource.data.feedId == '';
        allow update: if careId == 'state' && child(family) && valid() && (start() || finish() || feed());
        allow delete: if false;
      }
      match /garden/{itemId} {
        function ownsFurniture() {
          let starters = {'starter-bench':'bench','starter-pot':'pot','starter-cushion':'cushion','starter-table':'table'};
          let familyData = get(/databases/$(database)/documents/families/$(family)).data;
          let kind = request.resource.data.kind;
          return (itemId in starters && kind == starters[itemId])
            || ('gardenInventory' in familyData && itemId in familyData.gardenInventory && kind == familyData.gardenInventory[itemId]);
        }
        allow read, delete: if parent(family) || child(family);
        allow create, update: if (parent(family) || child(family))
          && request.resource.data.keys().hasAll(['kind','x','y'])
          && request.resource.data.keys().hasOnly(['kind','x','y'])
          && request.resource.data.kind in ['bench','pot','cushion','table']
          && request.resource.data.x is int && request.resource.data.y is int
          && request.resource.data.x >= 1 && request.resource.data.x <= 18
          && request.resource.data.y >= 1 && request.resource.data.y <= 10
          && !(request.resource.data.x >= 15 && request.resource.data.y <= 3)
          && ownsFurniture();
      }
      match /growthHistory/{cycleId} {
        allow read: if parent(family) || child(family);
        allow create: if parent(family)
          && request.resource.data.cycleId == cycleId
          && getAfter(/databases/$(database)/documents/families/$(family)).data.growth.id == cycleId
          && getAfter(/databases/$(database)/documents/families/$(family)).data.growth.stage == 4;
        allow update, delete: if false;
      }
      match /members/{uid} {
        allow get: if parent(family) || (signedIn() && request.auth.uid == uid);
        allow list, write: if parent(family);
      }
      match /joins/{uid} {
        allow get: if parent(family) || (signedIn() && request.auth.uid == uid);
        allow list: if parent(family);
        allow create: if signedIn() && request.auth.uid == uid
          && request.auth.token.firebase.sign_in_provider == 'anonymous'
          && exists(/databases/$(database)/documents/families/$(family))
          && request.resource.data.keys().hasOnly(['name', 'status'])
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 20
          && request.resource.data.status == 'pending';
        allow update, delete: if parent(family);
      }
      match /requests/{id} {
        allow read: if parent(family) || (child(family) && resource.data.uid == request.auth.uid);
        allow create: if child(family)
          && request.resource.data.keys().hasOnly(['uid','type','itemId','day','status','at'])
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.type in ['chore','reward']
          && request.resource.data.itemId is string && request.resource.data.itemId.size() <= 64
          && request.resource.data.day is string && request.resource.data.day.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
          && request.resource.data.at is number
          && request.resource.data.status == 'pending'
          && (request.resource.data.type == 'reward' || id == request.auth.uid + '_' + request.resource.data.itemId + '_' + request.resource.data.day);
        allow update: if parent(family)
          && resource.data.status == 'pending'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
          && request.resource.data.status in ['approved','rejected'];
        allow update: if child(family) && resource.data.uid == request.auth.uid
          && resource.data.status == 'rejected' && request.resource.data.status == 'pending'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','at'])
          && request.resource.data.at is number;
        allow delete: if false;
      }
    }
  }
}
